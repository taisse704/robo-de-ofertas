{
  "manifest_version": 3,
  "name": "Robô de Ofertas — Links Mercado Livre",
  "version": "1.2.2",
  "description": "Ponte automática entre o Robô de Ofertas e o Gerador de Links do Mercado Livre.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://mercadolivre.com.br/*",
    "https://taisse704.github.io/robo-de-ofertas/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://taisse704.github.io/robo-de-ofertas/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://mercadolivre.com.br/*"
      ],
      "js": [
        "mercado-livre.js"
      ],
      "run_at": "document_start"
    }
  ]
}
{
  "manifest_version": 3,
  "name": "Robô de Ofertas — Afiliados e Vídeos Originais",
  "version": "1.3.1",
  "description": "Geração de links oficiais do Mercado Livre e captura de vídeos originais de anúncios compatíveis.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://mercadolivre.com.br/*",
    "https://*.shopee.com.br/*",
    "https://shopee.com.br/*",
    "https://taisse704.github.io/robo-de-ofertas/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://taisse704.github.io/robo-de-ofertas/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://mercadolivre.com.br/*"
      ],
      "js": [
        "mercado-livre.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://mercadolivre.com.br/*",
        "https://*.shopee.com.br/*",
        "https://shopee.com.br/*"
      ],
      "js": [
        "product-video-capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

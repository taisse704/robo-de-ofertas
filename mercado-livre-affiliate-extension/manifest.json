{
  "manifest_version": 3,
  "name": "Robô de Ofertas — Shopee + Mercado Livre",
  "version": "1.5.1",
  "description": "Extensão única para captura de vídeos originais em anúncios Shopee/Mercado Livre e geração de links oficiais de afiliado do Mercado Livre.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://mercadolivre.com.br/*",
    "https://*.shopee.com.br/*",
    "https://shopee.com.br/*",
    "https://taisse704.github.io/robo-de-ofertas/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://taisse704.github.io/robo-de-ofertas/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://mercadolivre.com.br/*"
      ],
      "js": [
        "mercado-livre.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://mercadolivre.com.br/*",
        "https://*.shopee.com.br/*",
        "https://shopee.com.br/*"
      ],
      "js": [
        "page-video-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://mercadolivre.com.br/*",
        "https://*.shopee.com.br/*",
        "https://shopee.com.br/*"
      ],
      "js": [
        "product-video-capture.js"
      ],
      "run_at": "document_start"
    }
  ]
}
